<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf">
  <Style x:Key="{x:Static markdig:Styles.DocumentStyleKey}" TargetType="{x:Type FlowDocument}">
    <Setter Property="FlowDocument.FontFamily" Value="{DynamicResource LaunchFontFamily}" />
    <Setter Property="FlowDocument.FontSize" Value="15" />
    <Setter Property="FlowDocument.TextAlignment" Value="Left" />
    <Setter Property="FlowDocument.LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
  </Style>
  <Style x:Key="{x:Type Paragraph}" TargetType="{x:Type Paragraph}">
    <Setter Property="Block.Margin" Value="0,4,0,4" />
    <Setter Property="Paragraph.TextIndent" Value="0" />
  </Style>
  <Style x:Key="{x:Type List}" TargetType="{x:Type List}">
    <Setter Property="Block.Margin" Value="24,2,0,2" />
    <Setter Property="Block.Padding" Value="0" />
  </Style>
  <Style x:Key="{x:Static markdig:Styles.CodeBlockStyleKey}" TargetType="{x:Type Paragraph}">
    <Setter Property="Background" Value="{DynamicResource ColorBrush6}" />
    <Setter Property="FontFamily" Value="Consolas, Courier New, monospace" />
    <Setter Property="Block.Margin" Value="0,6,0,6" />
    <Setter Property="Block.Padding" Value="8,6,8,6" />
  </Style>
  <Style x:Key="{x:Static markdig:Styles.CodeStyleKey}" TargetType="{x:Type Run}">
    <Setter Property="Background" Value="{DynamicResource ColorBrush6}" />
    <Setter Property="FontFamily" Value="Consolas, Courier New, monospace" />
  </Style>
  <Style x:Key="{x:Static markdig:Styles.Heading1StyleKey}" TargetType="{x:Type Paragraph}">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Block.Margin" Value="0,12,0,8" />
  </Style>
  <Style x:Key="{x:Static markdig:Styles.Heading2StyleKey}" TargetType="{x:Type Paragraph}">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Block.Margin" Value="0,10,0,6" />
  </Style>
  <Style x:Key="{x:Static markdig:Styles.Heading3StyleKey}" TargetType="{x:Type Paragraph}">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Block.Margin" Value="0,8,0,4" />
  </Style>
  <Style x:Key="{x:Static markdig:Styles.Heading4StyleKey}" TargetType="{x:Type Paragraph}">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Block.Margin" Value="0,6,0,4" />
  </Style>
  <Style x:Key="{x:Static markdig:Styles.Heading5StyleKey}" TargetType="{x:Type Paragraph}">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Block.Margin" Value="0,4,0,4" />
  </Style>
  <Style x:Key="{x:Static markdig:Styles.Heading6StyleKey}" TargetType="{x:Type Paragraph}">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Block.Margin" Value="0,4,0,4" />
  </Style>
  <Style x:Key="{x:Static markdig:Styles.HyperlinkStyleKey}" TargetType="{x:Type Hyperlink}">
    <Setter Property="Foreground" Value="{DynamicResource ColorBrush4}" />
  </Style>
  <Style x:Key="{x:Static markdig:Styles.ThematicBreakStyleKey}" TargetType="{x:Type Line}">
    <Setter Property="Shape.Stretch" Value="Fill" />
    <Setter Property="Stroke" Value="{DynamicResource ColorBrush5}" />
  </Style>
  <Style x:Key="{x:Static markdig:Styles.QuoteBlockStyleKey}" TargetType="{x:Type Section}">
    <Setter Property="Block.BorderBrush" Value="{DynamicResource ColorBrushGray5}" />
    <Setter Property="Block.BorderThickness" Value="2,0,0,0" />
    <Setter Property="Foreground" Value="{DynamicResource ColorBrushGray2}" />
    <Setter Property="Background" Value="{DynamicResource ColorBrushGray7}" />
    <Setter Property="Block.Padding" Value="8,2,0,2" />
    <Setter Property="Block.Margin" Value="0,4,0,4" />
  </Style>
  <Style x:Key="{x:Static markdig:Styles.TableStyleKey}" TargetType="{x:Type Table}">
    <Setter Property="Block.BorderBrush" Value="{DynamicResource ColorBrushGray3}" />
    <Setter Property="Block.BorderThickness" Value="0,0,1,1" />
    <Setter Property="Table.CellSpacing" Value="0" />
    <Setter Property="Block.Margin" Value="0,6,0,6" />
  </Style>
  <Style x:Key="{x:Static markdig:Styles.TableCellStyleKey}" TargetType="{x:Type TableCell}">
    <Setter Property="TableCell.BorderBrush" Value="{DynamicResource ColorBrushGray3}" />
    <Setter Property="TableCell.BorderThickness" Value="1,1,0,0" />
    <Setter Property="TableCell.Padding" Value="4,2" />
  </Style>
  <Style x:Key="{x:Static markdig:Styles.TableHeaderStyleKey}" TargetType="{x:Type TableRow}">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="{DynamicResource ColorBrushGray6}" />
  </Style>
  <Style x:Key="{x:Static markdig:Styles.TaskListStyleKey}" TargetType="{x:Type CheckBox}">
    <Setter Property="Margin" Value="0,0,0,-2" />
  </Style>
  <Style x:Key="{x:Static markdig:Styles.SubscriptStyleKey}" TargetType="{x:Type Span}">
    <Setter Property="Typography.Variants" Value="Subscript" />
  </Style>
  <Style x:Key="{x:Static markdig:Styles.SuperscriptStyleKey}" TargetType="{x:Type Span}">
    <Setter Property="Typography.Variants" Value="Superscript" />
  </Style>
  <Style x:Key="{x:Static markdig:Styles.StrikeThroughStyleKey}" TargetType="{x:Type Span}">
    <Setter Property="TextBlock.TextDecorations" Value="Strikethrough" />
    <Setter Property="Foreground" Value="{DynamicResource ColorBrushGray4}" />
  </Style>
  <Style x:Key="{x:Static markdig:Styles.InsertedStyleKey}" TargetType="{x:Type Span}">
    <Setter Property="TextBlock.TextDecorations" Value="Underline" />
  </Style>
  <Style x:Key="{x:Static markdig:Styles.MarkedStyleKey}" TargetType="{x:Type Span}">
    <Setter Property="Background" Value="{DynamicResource ColorBrush5}" />
  </Style>
  <Style x:Key="{x:Type markdig:MarkdownViewer}" TargetType="{x:Type markdig:MarkdownViewer}">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type markdig:MarkdownViewer}">
          <FlowDocumentScrollViewer Document="{TemplateBinding markdig:MarkdownViewer.Document}" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionBrush="{DynamicResource ColorBrush6}" ContextMenu="{x:Null}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>