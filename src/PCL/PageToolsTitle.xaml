<?xml version="1.0" encoding="utf-8"?>
<local:MyPageRight x:Class="PCL.PageToolsTitle" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" PanScroll="{Binding ElementName=PanBack}">
  <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Name="PanMain" Margin="25,10">
      <local:MyHint Text="配置主标题、副标题和物品栏上方文字，实时预览并生成 /title 指令。主标题与副标题在 Minecraft 中是两个独立字段，必须各用一条子命令设置。" Theme="Blue" Margin="0,0,0,15" MinHeight="36" />
      <StackPanel>
        <StackPanel>
          <local:MyCard Margin="0,0,0,15" Title="目标与时间">
            <StackPanel Margin="25,32,25,16">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="目标选择器" Margin="0,0,14,0" />
                <local:MyTextBox Height="28" x:Name="TextTarget" Grid.Column="1" Text="@a" TextChanged="Option_Changed" />
              </Grid>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="14" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="14" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="淡入（刻）" Margin="0,0,0,6" Opacity="0.85" />
                  <local:MyTextBox Height="28" x:Name="TextFadeIn" Text="10" TextChanged="Option_Changed" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="停留（刻）" Margin="0,0,0,6" Opacity="0.85" />
                  <local:MyTextBox Height="28" x:Name="TextStay" Text="70" TextChanged="Option_Changed" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Text="淡出（刻）" Margin="0,0,0,6" Opacity="0.85" />
                  <local:MyTextBox Height="28" x:Name="TextFadeOut" Text="20" TextChanged="Option_Changed" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </local:MyCard>
          <local:MyCard Margin="0,0,0,15" Title="标题">
            <StackPanel Margin="25,32,25,16">
              <local:MyTextBox Height="28" x:Name="TextTitle" HintText="主标题，留空则不生成" TextChanged="Option_Changed" />
              <TextBlock Text="颜色" Margin="0,12,0,6" Opacity="0.85" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <local:MyComboBox Height="28" MaxDropDownHeight="360" Width="260" HorizontalAlignment="Left" x:Name="ComboTitleColor" SelectionChanged="Option_Changed" />
                <WrapPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                  <local:MyCheckBox x:Name="CheckTitleBold" Text="粗体" Height="22" Width="80" Change="Option_Change" />
                  <local:MyCheckBox x:Name="CheckTitleItalic" Text="斜体" Height="22" Width="80" Change="Option_Change" />
                </WrapPanel>
              </Grid>
            </StackPanel>
          </local:MyCard>
          <local:MyCard Margin="0,0,0,15" Title="副标题">
            <StackPanel Margin="25,32,25,16">
              <local:MyTextBox Height="28" x:Name="TextSubtitle" HintText="显示在标题下方，留空则不生成" TextChanged="Option_Changed" />
              <TextBlock Text="颜色" Margin="0,12,0,6" Opacity="0.85" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <local:MyComboBox Height="28" MaxDropDownHeight="360" Width="260" HorizontalAlignment="Left" x:Name="ComboSubtitleColor" SelectionChanged="Option_Changed" />
                <WrapPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                  <local:MyCheckBox x:Name="CheckSubtitleBold" Text="粗体" Height="22" Width="80" Change="Option_Change" />
                  <local:MyCheckBox x:Name="CheckSubtitleItalic" Text="斜体" Height="22" Width="80" Change="Option_Change" />
                </WrapPanel>
              </Grid>
            </StackPanel>
          </local:MyCard>
          <local:MyCard Margin="0,0,0,15" Title="物品栏文字（Actionbar）">
            <StackPanel Margin="25,32,25,16">
              <local:MyTextBox Height="28" x:Name="TextActionBar" HintText="显示在物品栏上方，留空则不生成" TextChanged="Option_Changed" />
              <TextBlock Text="颜色" Margin="0,12,0,6" Opacity="0.85" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <local:MyComboBox Height="28" MaxDropDownHeight="360" Width="260" HorizontalAlignment="Left" x:Name="ComboActionColor" SelectionChanged="Option_Changed" />
                <WrapPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                  <local:MyCheckBox x:Name="CheckActionBold" Text="粗体" Height="22" Width="80" Change="Option_Change" />
                  <local:MyCheckBox x:Name="CheckActionItalic" Text="斜体" Height="22" Width="80" Change="Option_Change" />
                </WrapPanel>
              </Grid>
            </StackPanel>
          </local:MyCard>
        </StackPanel>
        <StackPanel>
          <local:MyCard Margin="0,0,0,15" Title="游戏内预览">
            <StackPanel Margin="25,32,25,20">
              <Border Background="#FF202326" CornerRadius="6" Height="180" Padding="14">
                <Grid>
                  <StackPanel VerticalAlignment="Top" Margin="0,10,0,0">
                    <TextBlock x:Name="PreviewTitle" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="PreviewSubtitle" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
                  </StackPanel>
                  <TextBlock x:Name="PreviewAction" FontSize="13" VerticalAlignment="Bottom" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                </Grid>
              </Border>
              <TextBlock Text="预览只是近似效果，实际位置和缩放由游戏决定。" Opacity="0.6" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </local:MyCard>
          <local:MyCard Title="生成的指令（按顺序全部执行）">
            <StackPanel Margin="25,32,25,16">
              <TextBox x:Name="TextCommands" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="140" Background="Transparent" BorderThickness="0" />
              <TextBlock Text="说明：Minecraft 的 /title 没有“一条指令同时设置主标题和副标题”的语法。title 与 subtitle 是两个独立字段，必须分别下发；times 只在自定义淡入/停留/淡出时才生成；actionbar 是物品栏上方的独立区域。把这几条按顺序执行，就会同时显示主标题和副标题。" Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
              <local:MyButton Height="35" Text="复制全部指令" Width="140" HorizontalAlignment="Left" Margin="0,10,0,0" ColorType="Highlight" Click="BtnCopy_Click" />
            </StackPanel>
          </local:MyCard>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </local:MyScrollViewer>
</local:MyPageRight>
