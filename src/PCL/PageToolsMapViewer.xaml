<?xml version="1.0" encoding="utf-8"?>
<local:MyPageRight x:Class="PCL.PageToolsMapViewer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" PanScroll="{Binding ElementName=PanBack}">
  <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Name="PanMain" Margin="25,10">
      <local:MyHint Text="{DynamicResource Tools.MapViewer.LocalHint}" Theme="Blue" Margin="0,0,0,15" MinHeight="36" />
      <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Tools.MapViewer.Title}">
        <StackPanel Margin="25,32,25,16">
          <TextBlock Text="{DynamicResource Tools.MapViewer.Seed}" Margin="0,0,0,6" Opacity="0.85" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <local:MyTextBox x:Name="TextSeed" MinWidth="160" MaxLength="40" />
            <local:MyButton x:Name="BtnRandom" Grid.Column="1" Click="BtnRandom_Click" Width="76" Text="{DynamicResource Tools.MapViewer.Random}" Margin="10,0,0,0" />
            <local:MyButton x:Name="BtnRender" Grid.Column="2" Click="BtnRender_Click" Width="100" Text="{DynamicResource Tools.MapViewer.Render}" Margin="10,0,0,0" />
          </Grid>
          <TextBlock Text="{DynamicResource Tools.MapViewer.Version}" Margin="0,14,0,6" Opacity="0.85" />
          <local:MyComboBox x:Name="ComboVersion" Width="300" HorizontalAlignment="Left" MinWidth="190" SelectionChanged="ComboVersion_SelectionChanged" />
          <TextBlock Text="{DynamicResource Tools.MapViewer.Dimension}" Margin="0,14,0,6" Opacity="0.85" />
          <local:MyComboBox x:Name="ComboDimension" Width="220" HorizontalAlignment="Left" MinWidth="140" SelectionChanged="ComboDimension_SelectionChanged" />
        </StackPanel>
      </local:MyCard>
      <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Tools.MapViewer.PreviewTitle}">
        <Grid Margin="4,34,4,4" ClipToBounds="True">
          <wv2:WebView2CompositionControl x:Name="WebMap" MinHeight="560" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Grid>
      </local:MyCard>
    </StackPanel>
  </local:MyScrollViewer>
</local:MyPageRight>