<?xml version="1.0" encoding="utf-8"?>
<local:MyPageRight x:Class="PCL.PageToolsPlayerData" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformations.org/markup-compatibility/2006" PanScroll="{Binding ElementName=PanBack}">
  <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Name="PanMain" Margin="25,10">
      <local:MyHint Text="直接读取存档中的 playerdata/*.dat，修改游戏模式、生命、饥饿、经验和坐标。修改前会自动备份原文件。" Theme="Yellow" Margin="0,0,0,15" MinHeight="36" />
      <local:MyCard Margin="0,0,0,15" Title="玩家存档">
        <StackPanel Margin="25,32,25,16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <local:MyTextBox Height="28" x:Name="TextPath" IsReadOnly="True" HintText="选择 world/playerdata 里的 .dat 文件" />
            <local:MyButton Height="35" Grid.Column="1" Text="选择文件" Width="100" Margin="10,0,0,0" Click="BtnBrowse_Click" />
            <local:MyButton Height="35" Grid.Column="2" Text="重新读取" Width="100" Margin="10,0,0,0" Click="BtnReload_Click" />
          </Grid>
          <TextBlock x:Name="LabInfo" Margin="0,10,0,0" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>
      </local:MyCard>
      <StackPanel x:Name="PanEditor" Visibility="Collapsed">
        <local:MyCard Margin="0,0,0,15" Title="基础属性">
          <StackPanel Margin="25,32,25,16">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="游戏模式" VerticalAlignment="Center" Margin="0,0,12,10" />
              <local:MyComboBox Height="28" MaxDropDownHeight="360" x:Name="ComboGameMode" Grid.Column="1" Margin="0,0,18,10" />
              <TextBlock Grid.Column="2" Text="等级" VerticalAlignment="Center" Margin="0,0,12,10" />
              <local:MyTextBox Height="28" x:Name="TextLevel" Grid.Column="3" Margin="0,0,0,10" />
              <TextBlock Grid.Row="1" Text="生命值" VerticalAlignment="Center" Margin="0,0,12,10" />
              <local:MyTextBox Height="28" x:Name="TextHealth" Grid.Row="1" Grid.Column="1" Margin="0,0,18,10" />
              <TextBlock Grid.Row="1" Grid.Column="2" Text="饥饿值" VerticalAlignment="Center" Margin="0,0,12,10" />
              <local:MyTextBox Height="28" x:Name="TextFood" Grid.Row="1" Grid.Column="3" Margin="0,0,0,10" />
              <TextBlock Grid.Row="2" Text="经验" VerticalAlignment="Center" Margin="0,0,12,10" />
              <local:MyTextBox Height="28" x:Name="TextXp" Grid.Row="2" Grid.Column="1" Margin="0,0,18,10" />
              <TextBlock Grid.Row="2" Grid.Column="2" Text="选中槽位" VerticalAlignment="Center" Margin="0,0,12,10" />
              <local:MyTextBox Height="28" x:Name="TextSlot" Grid.Row="2" Grid.Column="3" Margin="0,0,0,10" />
              <TextBlock Grid.Row="3" Text="坐标 X / Y / Z" VerticalAlignment="Center" Margin="0,0,12,0" />
              <local:MyTextBox Height="28" x:Name="TextX" Grid.Row="3" Grid.Column="1" Margin="0,0,8,0" />
              <local:MyTextBox Height="28" x:Name="TextY" Grid.Row="3" Grid.Column="2" Margin="8,0,8,0" />
              <local:MyTextBox Height="28" x:Name="TextZ" Grid.Row="3" Grid.Column="3" />
            </Grid>
          </StackPanel>
        </local:MyCard>
        <local:MyCard Margin="0,0,0,15" Title="重生点">
          <StackPanel Margin="25,32,25,16">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,8,0" />
              <local:MyTextBox Height="28" x:Name="TextSpawnX" Grid.Column="1" Margin="0,0,12,0" />
              <TextBlock Grid.Column="2" Text="Y" VerticalAlignment="Center" Margin="0,0,8,0" />
              <local:MyTextBox Height="28" x:Name="TextSpawnY" Grid.Column="3" Margin="0,0,12,0" />
              <TextBlock Grid.Column="4" Text="Z" VerticalAlignment="Center" Margin="0,0,8,0" />
              <local:MyTextBox Height="28" x:Name="TextSpawnZ" Grid.Column="5" />
            </Grid>
            <local:MyCheckBox x:Name="CheckSpawnForced" Text="强制重生点" Height="22" Margin="0,10,0,0" />
          </StackPanel>
        </local:MyCard>
        <local:MyCard Margin="0,0,0,15" Title="物品栏">
          <StackPanel Margin="25,32,25,16">
            <ListBox x:Name="ListInventory" Height="260" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Height="26">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="56" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SlotText}" Opacity="0.6" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" />
                    <TextBlock Grid.Column="2" Text="{Binding Count}" Opacity="0.8" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel Margin="0,10,0,0">
              <local:MyButton Height="35" Text="删除选中物品" Width="120" Margin="0,0,8,8" ColorType="Red" Click="BtnDeleteItem_Click" />
              <local:MyButton Height="35" Text="清空物品栏" Width="120" Margin="0,0,8,8" ColorType="Red" Click="BtnClearInventory_Click" />
            </WrapPanel>
          </StackPanel>
        </local:MyCard>
      </StackPanel>
      <local:MyCard Margin="0,0,0,15" Title="保存">
        <StackPanel Margin="25,32,25,16" Orientation="Horizontal">
          <local:MyButton Height="35" Text="保存到原文件（自动备份）" Width="200" ColorType="Highlight" Click="BtnSave_Click" />
          <local:MyButton Height="35" Text="另存为" Width="110" Margin="12,0,0,0" Click="BtnSaveAs_Click" />
        </StackPanel>
      </local:MyCard>
    </StackPanel>
  </local:MyScrollViewer>
</local:MyPageRight>