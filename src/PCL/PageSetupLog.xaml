<?xml version="1.0" encoding="utf-8"?>
<local:MyPageRight x:Class="PCL.PageSetupLog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:PCL" RenderOptions.BitmapScalingMode="LowQuality" PanScroll="{Binding ElementName=PanBack}">
  <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <DockPanel>
      <local:MyCard DockPanel.Dock="Top" Title="{DynamicResource Setup.Log.Operations}" Margin="25,25,25,5">
        <WrapPanel ItemHeight="35" Margin="25,40,20,20">
          <local:MyButton Click="ButtonExport_OnClick" MinWidth="100" Text="{DynamicResource Setup.Log.Export}" ColorType="Highlight" Margin="0,0,15,0" />
          <local:MyButton Click="ButtonExportAll_OnClick" MinWidth="120" Text="{DynamicResource Setup.Log.ExportAll}" ColorType="Normal" Margin="0,0,15,0" />
          <local:MyButton Click="ButtonOpenDir_OnClick" MinWidth="120" Text="{DynamicResource Setup.Log.OpenDirectory}" ColorType="Normal" Margin="0,0,15,0" />
          <local:MyButton Click="ButtonClean_OnClick" MinWidth="120" Text="{DynamicResource Setup.Log.ClearHistory}" ColorType="Red" />
        </WrapPanel>
      </local:MyCard>
      <local:MyCard x:Name="PanContent" Title="{DynamicResource Setup.Log.AllLogs}" Margin="25,10,25,25">
        <StackPanel Name="PanList" Orientation="Vertical" Margin="20,36,18,18" />
      </local:MyCard>
    </DockPanel>
  </local:MyScrollViewer>
</local:MyPageRight>