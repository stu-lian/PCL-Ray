<?xml version="1.0" encoding="utf-8"?>
<local:MyPageRight x:Class="PCL.PageToolsArmorTrim" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" PanScroll="{Binding ElementName=PanBack}">
  <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Name="PanMain" Margin="25,10">
      <local:MyHint Text="选择盔甲材质后，每个部位都能单独开关，并分别挑选纹饰图案和纹饰材料；下方会生成对应的 give 指令。" Theme="Blue" Margin="0,0,0,15" MinHeight="36" />
      <local:MyCard Margin="0,0,0,15" Title="盔甲材质">
        <StackPanel Margin="25,32,25,16">
          <local:MyComboBox Height="28" MaxDropDownHeight="360" Width="320" HorizontalAlignment="Left" x:Name="ComboArmor" SelectionChanged="Option_Changed" />
          <TextBlock Text="目标选择器" Margin="0,12,0,6" Opacity="0.85" />
          <local:MyTextBox Height="28" Width="320" HorizontalAlignment="Left" x:Name="TextTarget" Text="@p" TextChanged="Target_Changed" />
        </StackPanel>
      </local:MyCard>
      <local:MyCard Margin="0,0,0,15" Title="部位与纹饰">
        <StackPanel Margin="25,32,25,16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="200" />
              <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="纹饰图案" Opacity="0.7" Margin="0,0,0,6" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="纹饰材料" Opacity="0.7" Margin="8,0,0,6" />
            <local:MyCheckBox Grid.Row="1" Grid.Column="0" x:Name="CheckHelmet" Text="头盔" Height="28" VerticalAlignment="Center" Change="Option_Change" />
            <local:MyComboBox Grid.Row="1" Grid.Column="1" x:Name="ComboHelmetPattern" Height="28" MaxDropDownHeight="360" Margin="0,0,8,10" SelectionChanged="Option_Changed" />
            <local:MyComboBox Grid.Row="1" Grid.Column="2" x:Name="ComboHelmetMaterial" Height="28" MaxDropDownHeight="360" Margin="8,0,0,10" SelectionChanged="Option_Changed" />
            <local:MyCheckBox Grid.Row="2" Grid.Column="0" x:Name="CheckChestplate" Text="胸甲" Height="28" VerticalAlignment="Center" Change="Option_Change" />
            <local:MyComboBox Grid.Row="2" Grid.Column="1" x:Name="ComboChestPattern" Height="28" MaxDropDownHeight="360" Margin="0,0,8,10" SelectionChanged="Option_Changed" />
            <local:MyComboBox Grid.Row="2" Grid.Column="2" x:Name="ComboChestMaterial" Height="28" MaxDropDownHeight="360" Margin="8,0,0,10" SelectionChanged="Option_Changed" />
            <local:MyCheckBox Grid.Row="3" Grid.Column="0" x:Name="CheckLeggings" Text="护腿" Height="28" VerticalAlignment="Center" Change="Option_Change" />
            <local:MyComboBox Grid.Row="3" Grid.Column="1" x:Name="ComboLeggingsPattern" Height="28" MaxDropDownHeight="360" Margin="0,0,8,10" SelectionChanged="Option_Changed" />
            <local:MyComboBox Grid.Row="3" Grid.Column="2" x:Name="ComboLeggingsMaterial" Height="28" MaxDropDownHeight="360" Margin="8,0,0,10" SelectionChanged="Option_Changed" />
            <local:MyCheckBox Grid.Row="4" Grid.Column="0" x:Name="CheckBoots" Text="靴子" Height="28" VerticalAlignment="Center" Change="Option_Change" />
            <local:MyComboBox Grid.Row="4" Grid.Column="1" x:Name="ComboBootsPattern" Height="28" MaxDropDownHeight="360" Margin="0,0,8,0" SelectionChanged="Option_Changed" />
            <local:MyComboBox Grid.Row="4" Grid.Column="2" x:Name="ComboBootsMaterial" Height="28" MaxDropDownHeight="360" Margin="8,0,0,0" SelectionChanged="Option_Changed" />
          </Grid>
        </StackPanel>
      </local:MyCard>
      <local:MyCard Margin="0,0,0,15" Title="纹饰预览">
        <StackPanel Margin="25,32,25,20">
          <Border Background="#FF202326" CornerRadius="6" Height="360" Padding="18">
            <Viewbox Stretch="Uniform">
              <Image x:Name="PreviewImage" Width="96" Height="192" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Viewbox>
          </Border>
          <TextBlock x:Name="LabPatternInfo" Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
        </StackPanel>
      </local:MyCard>
      <local:MyCard Margin="0,0,0,15" Title="生成的指令">
        <StackPanel Margin="25,32,25,16">
          <TextBox x:Name="TextCommands" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="130" Background="Transparent" BorderThickness="0" />
          <WrapPanel Margin="0,10,0,0">
            <local:MyButton Height="35" Text="复制指令" Width="120" ColorType="Highlight" Click="BtnCopy_Click" />
          </WrapPanel>
        </StackPanel>
      </local:MyCard>
      <local:MyCard Title="锻造配方">
        <StackPanel Margin="25,32,25,20">
          <TextBlock x:Name="LabRecipe" TextWrapping="Wrap" Opacity="0.8" />
        </StackPanel>
      </local:MyCard>
    </StackPanel>
  </local:MyScrollViewer>
</local:MyPageRight>
