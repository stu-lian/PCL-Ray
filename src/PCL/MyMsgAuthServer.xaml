<?xml version="1.0" encoding="utf-8"?>
<Grid x:Class="PCL.MyMsgAuthServer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:my="clr-namespace:PCL" RenderTransformOrigin="0,0.5" UseLayoutRounding="True" SnapsToDevicePixels="True" MinWidth="400" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="25">
  <UIElement.RenderTransform>
    <TransformGroup>
      <RotateTransform x:Name="TransformRotate" Angle="-4" />
      <TranslateTransform x:Name="TransformPos" X="0" Y="40" />
    </TransformGroup>
  </UIElement.RenderTransform>
  <Border Name="PanBorder" CornerRadius="7" Background="{DynamicResource ColorBrushBackground}">
    <UIElement.Effect>
      <DropShadowEffect Color="{DynamicResource ColorObjectMsgBoxShadow}" BlurRadius="20" ShadowDepth="2" RenderingBias="Performance" Opacity="0.8" />
    </UIElement.Effect>
    <Grid Margin="22,22,22,23">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="2" />
        <RowDefinition Height="13" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Name="LabTitle" Grid.Row="0" FontSize="23" Foreground="{DynamicResource ColorBrush2}" HorizontalAlignment="Left" Margin="7,-1,70,9" />
      <Rectangle Name="ShapeLine" Grid.Row="1" Height="2" Fill="{Binding Foreground, ElementName=LabTitle}" />
      <my:MyComboBox x:Name="ComboServer" Grid.Row="4" Height="28" IsEditable="True" IsTextSearchEnabled="False" Margin="7,0,7,12" />
      <StackPanel Grid.Row="5" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="150,14,8,0" Orientation="Horizontal">
        <my:MyButton x:Name="Btn1" Click="Btn1_Click" ColorType="Normal" Margin="12,0,0,0" TextPadding="7" Padding="5,0" />
        <my:MyButton x:Name="Btn2" Click="Btn2_Click" ColorType="Normal" Margin="12,0,0,0" TextPadding="7" Padding="5,0" />
      </StackPanel>
    </Grid>
  </Border>
</Grid>