<?xml version="1.0" encoding="utf-8"?>
<local:MyPageRight x:Class="PCL.PageToolsModTranslate" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" PanScroll="{Binding ElementName=PanBack}">
  <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Name="PanMain" Margin="25,10">
      <local:MyHint Text="{DynamicResource Tools.ModTranslate.OnlineHint}" Theme="Blue" Margin="0,0,0,15" MinHeight="36" />
      <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Tools.ModTranslate.Title}">
        <StackPanel Margin="25,32,25,14">
          <!-- 拖放 / 选择 jar -->
          <Border x:Name="DropZone" AllowDrop="True" Height="96" CornerRadius="8" Background="{StaticResource ColorBrushGray2}" BorderBrush="{StaticResource ColorBrushGray3}" BorderThickness="1.5" DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave" Drop="DropZone_Drop" MouseLeftButtonUp="DropZone_Click" Cursor="Hand">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock x:Name="LabDropHint" Text="{DynamicResource Tools.ModTranslate.DropHint}" FontSize="14" Foreground="{StaticResource ColorBrushGray4}" />
              <TextBlock x:Name="LabJarPath" Text="" FontSize="12" Foreground="{StaticResource ColorBrushGray3}" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center" />
            </StackPanel>
          </Border>

          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource Tools.ModTranslate.TargetLang}" Margin="0,0,18,0" />
            <local:MyComboBox x:Name="ComboTargetLang" Grid.Column="1" Width="240" HorizontalAlignment="Left">
              <local:MyComboBoxItem Content="简体中文 (zh_cn)" IsSelected="True" />
              <local:MyComboBoxItem Content="繁體中文 (zh_tw)" />
              <local:MyComboBoxItem Content="日本語 (ja_jp)" />
              <local:MyComboBoxItem Content="한국어 (ko_kr)" />
            </local:MyComboBox>
            <local:MyButton x:Name="BtnTranslate" Grid.Column="2" Click="BtnTranslate_Click" Width="150" HorizontalAlignment="Right" Margin="16,0,0,0" Text="{DynamicResource Tools.ModTranslate.Translate}" ColorType="Highlight" />
          </Grid>

          <ProgressBar x:Name="ProgressBar" Height="6" Margin="0,16,0,0" Maximum="100" Foreground="{StaticResource ColorBrush3}" Background="{StaticResource ColorBrushGray2}" />
          <TextBlock x:Name="LabStatus" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource ColorBrushGray3}" TextWrapping="Wrap" />
        </StackPanel>
      </local:MyCard>
    </StackPanel>
  </local:MyScrollViewer>
</local:MyPageRight>