<?xml version="1.0" encoding="utf-8"?>
<local:MyPageRight x:Class="PCL.PageSetupLauncherMisc" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" PanScroll="{Binding ElementName=PanBack}">
  <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Name="PanMain" Margin="25,10">
      <local:MyCard Margin="0,15" Title="{DynamicResource Setup.Misc.System.Title}">
        <Grid Margin="25,40,25,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="9" />
            <RowDefinition Height="28" />
            <RowDefinition Height="5" />
            <RowDefinition Height="28" />
            <RowDefinition Height="5" />
            <RowDefinition Height="20" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource Setup.Misc.System.Announcement}" Margin="0,0,25,0" Grid.Row="0" />
          <local:MyComboBox x:Name="ComboSystemActivity" SelectionChanged="ComboSystemActivity_OnSelectionChanged" Tag="SystemSystemActivity" Grid.Column="1" Grid.Row="0">
            <local:MyComboBoxItem Content="{DynamicResource Setup.Misc.System.Announcement.All}" ToolTip="{DynamicResource Setup.Misc.System.Announcement.All.ToolTip}" />
            <local:MyComboBoxItem Content="{DynamicResource Setup.Misc.System.Announcement.ImportantOnly}" />
            <local:MyComboBoxItem Content="{DynamicResource Setup.Misc.System.Announcement.Disabled}" />
          </local:MyComboBox>
          <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource Setup.Misc.System.MaxFps}" Margin="0,0,25,0" />
          <local:MySlider x:Name="SliderAniFPS" Change="SliderChange" Grid.Row="2" Tag="UiAniFPS" MaxValue="59" Value="59" Grid.Column="1" ToolTip="{DynamicResource Setup.Misc.System.MaxFps.ToolTip}" />
          <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource Setup.Misc.System.MaxLogLines}" Margin="0,0,25,0" />
          <local:MySlider x:Name="SliderMaxLog" Change="SliderChange" Grid.Row="4" Tag="SystemMaxLog" MaxValue="29" Value="13" Grid.Column="1" ToolTip="{DynamicResource Setup.Misc.System.MaxLogLines.ToolTip}" />
          <Grid Row="6" ColumnSpan="5">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="CheckBox" />
              <ColumnDefinition Width="Auto" SharedSizeGroup="CheckBox" />
              <ColumnDefinition Width="Auto" SharedSizeGroup="CheckBox" />
              <ColumnDefinition Width="Auto" SharedSizeGroup="CheckBox" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="20" />
            </Grid.RowDefinitions>
            <local:MyCheckBox x:Name="CheckSystemDisableHardwareAcceleration" Change="CheckSystemDisableHardwareAcceleration_OnChange" Row="0" Column="0" Text="{DynamicResource Setup.Misc.System.DisableHardwareAcceleration}" Tag="SystemDisableHardwareAcceleration" />
            <local:MyCheckBox x:Name="CheckSystemTelemetry" Change="CheckBoxChange" Row="0" Column="1" Text="{DynamicResource Setup.Misc.System.Telemetry}" Tag="SystemTelemetry" ToolTip="{DynamicResource Setup.Misc.System.Telemetry.ToolTip}" />
          </Grid>
          <Grid Row="8" ColumnSpan="5">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
              <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
              <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
              <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="35" />
            </Grid.RowDefinitions>
            <local:MyButton x:Name="BtnSystemSettingExp" Click="BtnSystemSettingExp_Click" Grid.Column="0" Grid.Row="0" MinWidth="140" Text="{DynamicResource Setup.Misc.System.ExportSettings}" Padding="13,0" Margin="0,0,20,0" />
            <local:MyButton x:Name="BtnSystemSettingImp" Click="BtnSystemSettingImp_Click" Grid.Column="1" Grid.Row="0" MinWidth="140" Text="{DynamicResource Setup.Misc.System.ImportSettings}" Padding="13,0" Margin="0,0,20,0" />
            <local:MyButton x:Name="BtnSystemStopUsingPclCe" Click="BtnSystemStopUsingPclCe_Click" Grid.Column="2" Grid.Row="0" MinWidth="140" Text="{DynamicResource Setup.Misc.System.StopUsingPclCe}" Padding="13,0" Margin="0,0,20,0" ColorType="Red" />
          </Grid>
        </Grid>
      </local:MyCard>
      <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Setup.Misc.Network.Title}">
        <Grid Margin="25,38,25,15">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="4" />
            <RowDefinition Height="28" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <local:MyCheckBox x:Name="CheckNetDohEnable" Change="CheckBoxChange" Tag="SystemNetEnableDoH" Row="0" ColumnSpan="2" Text="{DynamicResource Setup.Misc.Network.DoH}" ToolTip="{DynamicResource Setup.Misc.Network.DoH.ToolTip}" />
          <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource Setup.Misc.Network.HttpProxy}" Margin="0,0,25,0" />
          <Grid Row="2" Column="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="0.2*" />
            </Grid.ColumnDefinitions>
            <local:MyRadioBox x:Name="RadioHttpProxyType0" Check="RadioBoxChange" Text="{DynamicResource Setup.Misc.Network.Proxy.None}" Height="22" Tag="SystemHttpProxyType/0" Column="0" />
            <local:MyRadioBox x:Name="RadioHttpProxyType1" Check="RadioBoxChange" Text="{DynamicResource Setup.Misc.Network.Proxy.System}" Height="22" Tag="SystemHttpProxyType/1" Column="1" />
            <local:MyRadioBox x:Name="RadioHttpProxyType2" Check="RadioBoxChange" Text="{DynamicResource Setup.Misc.Network.Proxy.Custom}" Height="22" Tag="SystemHttpProxyType/2" Column="2" />
          </Grid>
          <Grid Name="HttpProxyCustom" Row="4" Column="1" Visibility="{Binding ElementName=RadioHttpProxyType2, Path=Checked, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="28" />
              <RowDefinition Height="9" />
              <RowDefinition Height="28" />
              <RowDefinition Height="9" />
              <RowDefinition Height="28" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <local:MyHint Text="{DynamicResource Setup.Misc.Network.Proxy.UntrustedWarning}" Grid.Row="0" Grid.ColumnSpan="5" Theme="Yellow" />
            <local:MyTextBox x:Name="TextSystemHttpProxy" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Tag="SystemHttpProxy" HintText="比如 http://127.0.0.1:1080/" ToolTip="{DynamicResource Setup.Misc.Network.Proxy.InvalidWarning}" />
            <TextBlock Grid.Column="0" Grid.Row="4" Text="{DynamicResource Setup.Misc.Network.Proxy.Username}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,5,0" />
            <local:MyTextBox x:Name="TextSystemHttpProxyCustomUsername" Grid.Column="1" Grid.Row="4" HintText="{DynamicResource Setup.Misc.Network.Proxy.Optional}" Tag="SystemHttpProxyCustomUsername" Margin="0,0,5,0" />
            <TextBlock Grid.Column="2" Grid.Row="4" Text="{DynamicResource Setup.Misc.Network.Proxy.Password}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,5,0" />
            <local:MyTextBox x:Name="TextSystemHttpProxyCustomPassword" Grid.Column="3" Grid.Row="4" HintText="{DynamicResource Setup.Misc.Network.Proxy.Optional}" Tag="SystemHttpProxyCustomPassword" Margin="0,0,5,0" />
            <local:MyButton x:Name="BtnApplyHttpProxy" Click="ApplyHttpProxyBtn_OnClicked" Text="{DynamicResource Setup.Misc.Network.Proxy.Apply}" TextPadding="3" Grid.Row="4" Grid.Column="4" />
          </Grid>
        </Grid>
      </local:MyCard>
      <local:MyCard x:Name="CardDebug" Margin="0,0,0,15" Title="{DynamicResource Setup.Misc.Debug.Title}" CanSwap="True" IsSwapped="True">
        <StackPanel Margin="25,40,25,15">
          <Grid Name="PanDebugAnim" Height="22" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource Setup.Misc.Debug.AnimationSpeed}" Margin="0,0,25,0" />
            <local:MySlider x:Name="SliderDebugAnim" Change="SliderChange" Tag="SystemDebugAnim" MaxValue="30" Grid.Column="1" />
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.5*" />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <local:MyCheckBox x:Name="CheckDebugSkipCopy" Change="CheckBoxChange" Column="0" Text="{DynamicResource Setup.Misc.Debug.SkipCopy}" Height="22" Tag="SystemDebugSkipCopy" ToolTip="{DynamicResource Setup.Misc.Debug.SkipCopy.ToolTip}" />
            <local:MyCheckBox x:Name="CheckDebugMode" Change="CheckDebugMode_OnChange" Column="1" Text="{DynamicResource Setup.Misc.Debug.Mode}" Height="22" Tag="SystemDebugMode" ToolTip="{DynamicResource Setup.Misc.Debug.Mode.ToolTip}" />
            <local:MyCheckBox x:Name="CheckDebugDelay" Change="CheckBoxChange" Column="2" Text="{DynamicResource Setup.Misc.Debug.Delay}" Height="22" Tag="SystemDebugDelay" ToolTip="{DynamicResource Setup.Misc.Debug.Delay.ToolTip}" />
          </Grid>
        </StackPanel>
      </local:MyCard>
    </StackPanel>
  </local:MyScrollViewer>
</local:MyPageRight>