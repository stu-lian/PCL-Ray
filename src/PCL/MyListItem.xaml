<?xml version="1.0" encoding="utf-8"?>
<Grid x:Class="PCL.MyListItem" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="PanBack" RenderTransformOrigin="0.5,0.5" Background="{StaticResource ColorBrushSemiTransparent}" Height="42" xmlns:pcl="clr-namespace:PCL">
  <UIElement.RenderTransform>
    <ScaleTransform ScaleX="1" ScaleY="1" />
  </UIElement.RenderTransform>
  <Grid.ColumnDefinitions>
    <ColumnDefinition Name="ColumnCheck" Width="2" />
    <ColumnDefinition Name="ColumnPaddingLeft" Width="0" />
    <ColumnDefinition Name="ColumnLogo" Width="4" />
    <ColumnDefinition Width="Auto" />
    <ColumnDefinition Width="1*" />
    <ColumnDefinition Name="ColumnPaddingRight" Width="4" />
  </Grid.ColumnDefinitions>
  <Grid.RowDefinitions>
    <RowDefinition Height="1*" />
    <RowDefinition Height="Auto" />
    <RowDefinition Height="Auto" />
    <RowDefinition Height="1*" />
  </Grid.RowDefinitions>
  <TextBlock Name="LabTitle" Grid.Row="1" SnapsToDevicePixels="False" UseLayoutRounding="False" HorizontalAlignment="Left" IsHitTestVisible="False" Grid.Column="3" Grid.ColumnSpan="2" TextTrimming="CharacterEllipsis" Margin="4,0,0,0" Text="{Binding Title, ElementName=PanBack}" FontSize="{Binding FontSize, ElementName=PanBack}" Foreground="{Binding Foreground, ElementName=PanBack}" />
</Grid>