<?xml version="1.0" encoding="utf-8"?>
<local:MyPageRight x:Class="PCL.PageHelpDetail" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL" PanScroll="{Binding ElementName=PanBack}">
  <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Name="PanCustom" Margin="25,25,25,10">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BasedOnTextBlock}">
            <Setter Property="TextWrapping" Value="Wrap" />
          </Style>
          <Style x:Key="{x:Type local:MyCard}" TargetType="{x:Type local:MyCard}">
            <Setter Property="Margin" Value="0,0,0,15" />
          </Style>
          <Style x:Key="{x:Type Image}" TargetType="{x:Type Image}">
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
            <Setter Property="HorizontalAlignment" Value="Center" />
          </Style>
        </ResourceDictionary>
      </FrameworkElement.Resources>
    </StackPanel>
  </local:MyScrollViewer>
</local:MyPageRight>