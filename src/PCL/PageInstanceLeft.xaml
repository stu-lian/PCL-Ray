<?xml version="1.0" encoding="utf-8"?>
<local:MyPageLeft x:Class="PCL.PageInstanceLeft" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL" AnimatedControl="{Binding ElementName=PanItem, Mode=OneWay}">
  <local:MyScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Style="{StaticResource ScrollViewerFullMargin}">
    <StackPanel Name="PanItem" Margin="0,12,0,0">
      <TextBlock Text="{DynamicResource Instance.Left.Game}" Margin="13,6,5,4" Opacity="0.6" FontSize="12" />
      <local:MyListItem x:Name="ItemOverall" Check="PageCheck" IsScaleAnimationEnabled="False" Checked="True" Type="RadioBox" Tag="0" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="{DynamicResource Instance.Left.Overview}" SvgIcon="lucide/layout-dashboard" />
      <local:MyListItem x:Name="ItemSetup" Check="PageCheck" IsScaleAnimationEnabled="False" Tag="1" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="{DynamicResource Instance.Left.Settings}" Type="RadioBox" SvgIcon="lucide/settings">
        <local:MyListItem.Buttons>
          <x:ArrayExtension Type="{x:Type local:MyIconButton}">
            <local:MyIconButton Click="Reset" Tag="1" ToolTip="{DynamicResource Common.Action.Initialize}" ToolTipService.Placement="Right" ToolTipService.InitialShowDelay="200" ToolTipService.VerticalOffset="-1" SvgIcon="lucide/rotate-ccw" LogoScale="0.9" />
          </x:ArrayExtension>
        </local:MyListItem.Buttons>
      </local:MyListItem>
      <local:MyListItem x:Name="ItemInstall" Check="PageCheck" IsScaleAnimationEnabled="False" Type="RadioBox" Tag="10" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="{DynamicResource Instance.Left.Install}" LogoScale="0.87" SvgIcon="lucide/wrench">
        <local:MyListItem.Buttons>
          <x:ArrayExtension Type="{x:Type local:MyIconButton}">
            <local:MyIconButton Click="RefreshButton_Click" Tag="10" ToolTip="{DynamicResource Common.Action.Refresh}" ToolTipService.Placement="Right" ToolTipService.InitialShowDelay="200" ToolTipService.VerticalOffset="-1" LogoScale="0.85" SvgIcon="lucide/refresh-cw" />
          </x:ArrayExtension>
        </local:MyListItem.Buttons>
      </local:MyListItem>
      <local:MyListItem x:Name="ItemExport" Check="PageCheck" IsScaleAnimationEnabled="False" Type="RadioBox" Tag="2" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="{DynamicResource Instance.Left.Export}" SvgIcon="lucide/package">
        <local:MyListItem.Buttons>
          <x:ArrayExtension Type="{x:Type local:MyIconButton}">
            <local:MyIconButton Click="RefreshButton_Click" Tag="2" ToolTip="{DynamicResource Common.Action.Refresh}" ToolTipService.Placement="Right" ToolTipService.InitialShowDelay="200" ToolTipService.VerticalOffset="-1" LogoScale="0.85" SvgIcon="lucide/refresh-cw" />
          </x:ArrayExtension>
        </local:MyListItem.Buttons>
      </local:MyListItem>
      <TextBlock Name="TextResource" Text="{DynamicResource Instance.Left.Resources}" Margin="13,6,5,4" Opacity="0.6" FontSize="12" />
      <local:MyListItem x:Name="ItemWorld" Check="PageCheck" LogoScale="0.95" IsScaleAnimationEnabled="False" Type="RadioBox" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="{DynamicResource Instance.Left.Saves}" Tag="3" SvgIcon="lucide/globe">
        <local:MyListItem.Buttons>
          <x:ArrayExtension Type="{x:Type local:MyIconButton}">
            <local:MyIconButton Click="RefreshButton_Click" Tag="3" ToolTip="{DynamicResource Common.Action.Refresh}" ToolTipService.Placement="Right" ToolTipService.InitialShowDelay="200" ToolTipService.VerticalOffset="-1" LogoScale="0.85" SvgIcon="lucide/refresh-cw" />
          </x:ArrayExtension>
        </local:MyListItem.Buttons>
      </local:MyListItem>
      <local:MyListItem x:Name="ItemScreenshot" Check="PageCheck" LogoScale="0.95" IsScaleAnimationEnabled="False" Type="RadioBox" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="{DynamicResource Instance.Left.Screenshots}" Tag="4" SvgIcon="lucide/image">
        <local:MyListItem.Buttons>
          <x:ArrayExtension Type="{x:Type local:MyIconButton}">
            <local:MyIconButton Click="RefreshButton_Click" Tag="4" ToolTip="{DynamicResource Common.Action.Refresh}" ToolTipService.Placement="Right" ToolTipService.InitialShowDelay="200" ToolTipService.VerticalOffset="-1" LogoScale="0.85" SvgIcon="lucide/refresh-cw" />
          </x:ArrayExtension>
        </local:MyListItem.Buttons>
      </local:MyListItem>
      <local:MyListItem x:Name="ItemMod" Check="PageCheck" IsScaleAnimationEnabled="False" Type="RadioBox" Tag="5" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="{DynamicResource Instance.Left.Mod}" SvgIcon="lucide/puzzle">
        <local:MyListItem.Buttons>
          <x:ArrayExtension Type="{x:Type local:MyIconButton}">
            <local:MyIconButton Click="RefreshButton_Click" Tag="5" ToolTip="{DynamicResource Common.Action.Refresh}" ToolTipService.Placement="Right" ToolTipService.InitialShowDelay="200" ToolTipService.VerticalOffset="-1" LogoScale="0.85" SvgIcon="lucide/refresh-cw" />
          </x:ArrayExtension>
        </local:MyListItem.Buttons>
      </local:MyListItem>
      <local:MyListItem x:Name="ItemModDisabled" Check="PageCheck" IsScaleAnimationEnabled="False" Type="RadioBox" Tag="6" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="{DynamicResource Instance.Left.Mod}" SvgIcon="lucide/puzzle" />
      <local:MyListItem x:Name="ItemResourcePack" Check="PageCheck" LogoScale="0.85" IsScaleAnimationEnabled="False" Type="RadioBox" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="{DynamicResource Instance.Left.ResourcePacks}" Tag="7" SvgIcon="lucide/layers">
        <local:MyListItem.Buttons>
          <x:ArrayExtension Type="{x:Type local:MyIconButton}">
            <local:MyIconButton Click="RefreshButton_Click" Tag="7" ToolTip="{DynamicResource Common.Action.Refresh}" ToolTipService.Placement="Right" ToolTipService.InitialShowDelay="200" ToolTipService.VerticalOffset="-1" LogoScale="0.85" SvgIcon="lucide/refresh-cw" />
          </x:ArrayExtension>
        </local:MyListItem.Buttons>
      </local:MyListItem>
      <local:MyListItem x:Name="ItemShader" Check="PageCheck" LogoScale="1.15" IsScaleAnimationEnabled="False" Type="RadioBox" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="{DynamicResource Instance.Left.Shaders}" Tag="8" SvgIcon="lucide/sparkles">
        <local:MyListItem.Buttons>
          <x:ArrayExtension Type="{x:Type local:MyIconButton}">
            <local:MyIconButton Click="RefreshButton_Click" Tag="8" ToolTip="{DynamicResource Common.Action.Refresh}" ToolTipService.Placement="Right" ToolTipService.InitialShowDelay="200" ToolTipService.VerticalOffset="-1" LogoScale="0.85" SvgIcon="lucide/refresh-cw" />
          </x:ArrayExtension>
        </local:MyListItem.Buttons>
      </local:MyListItem>
      <local:MyListItem x:Name="ItemSchematic" Check="PageCheck" LogoScale="0.85" IsScaleAnimationEnabled="False" Type="RadioBox" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="{DynamicResource Instance.Left.Schematics}" Tag="9" SvgIcon="lucide/file-box">
        <local:MyListItem.Buttons>
          <x:ArrayExtension Type="{x:Type local:MyIconButton}">
            <local:MyIconButton Click="RefreshButton_Click" Tag="9" ToolTip="{DynamicResource Common.Action.Refresh}" ToolTipService.Placement="Right" ToolTipService.InitialShowDelay="200" ToolTipService.VerticalOffset="-1" LogoScale="0.85" SvgIcon="lucide/refresh-cw" />
          </x:ArrayExtension>
        </local:MyListItem.Buttons>
      </local:MyListItem>
      <local:MyListItem x:Name="ItemServer" Check="PageCheck" LogoScale="0.85" IsScaleAnimationEnabled="False" Type="RadioBox" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="{DynamicResource Instance.Left.Servers}" Tag="11" SvgIcon="lucide/server">
        <local:MyListItem.Buttons>
          <x:ArrayExtension Type="{x:Type local:MyIconButton}">
            <local:MyIconButton Click="RefreshButton_Click" Tag="11" ToolTip="{DynamicResource Common.Action.Refresh}" ToolTipService.Placement="Right" ToolTipService.InitialShowDelay="200" ToolTipService.VerticalOffset="-1" LogoScale="0.85" SvgIcon="lucide/refresh-cw" />
          </x:ArrayExtension>
        </local:MyListItem.Buttons>
      </local:MyListItem>
    </StackPanel>
  </local:MyScrollViewer>
</local:MyPageLeft>