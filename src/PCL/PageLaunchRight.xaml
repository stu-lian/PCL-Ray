<?xml version="1.0" encoding="utf-8"?>
<local:MyPageRight x:Class="PCL.PageLaunchRight" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL">
  <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Name="PanMain" Margin="25,25,25,10" Grid.IsSharedSizeScope="True">
      <StackPanel Name="PanCustom" />
      <local:MyCard x:Name="PanHint" Margin="0,0,0,15" Title="{DynamicResource Launch.Right.CommunityHint.Title}">
        <local:MyIconButton x:Name="BtnHintClose" Click="BtnHintClose_Click" LogoScale="1.1" SvgIcon="lucide/x" Height="20" Width="20" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top" />
        <StackPanel Margin="25,38,23,15">
          <TextBlock Name="LabHint1" TextWrapping="Wrap" Margin="0,0,0,2" FontSize="13.5" />
          <TextBlock Name="LabHint2" TextWrapping="Wrap" Margin="0,0,0,2" FontSize="13.5" />
        </StackPanel>
      </local:MyCard>
      <local:MyCard x:Name="PanLog" Margin="0,0,0,15" Title="{DynamicResource Launch.Right.Log.Title}">
        <TextBlock Name="LabLog" Margin="20,38,20,18" TextTrimming="None" TextWrapping="Wrap" />
      </local:MyCard>
    </StackPanel>
  </local:MyScrollViewer>
</local:MyPageRight>