  <String x:Key="Crash.Suggestion.LauncherOutdated" xmlns="clr-namespace:System;assembly=System.Private.CoreLib">You are using an outdated version of PCL Ray. Updating PCL Ray may resolve this problem: Settings → Launcher → Check updates.</String>
