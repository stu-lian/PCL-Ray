  <String x:Key="Crash.Suggestion.IncompleteForgeInstallation" xmlns="clr-namespace:System;assembly=System.Private.CoreLib">Reset or reinstall Forge in instance settings. Do not delete the libraries folder when packaging an instance.</String>
  <String x:Key="Crash.Suggestion.InvalidModFileName" xmlns="clr-namespace:System;assembly=System.Private.CoreLib">Remove or rename the affected mod file so that its name contains only English letters, numbers, hyphens, underscores, and periods.</String>
